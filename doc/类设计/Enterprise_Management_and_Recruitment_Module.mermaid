classDiagram
    %% 样式定义
    classDef controller fill:#e8f5e9,stroke:#2e7d32,color:#000;
    classDef service fill:#fff9c4,stroke:#fbc02d,color:#000;
    classDef dao fill:#bbdefb,stroke:#1565c0,color:#000;
    classDef entity fill:#f8bbd0,stroke:#ad1457,color:#000;
    classDef dto fill:#d1c4e9,stroke:#4527a0,color:#000;

    %% 用户服务层 (Controller)
    class TalentSearchController {
        -talentSearchService: TalentSearchService
        +searchTalents(TalentSearchDTO): Result
        +viewPublicResumes(Long): Result
        +inviteApply(Long, Long): Result
        +getRecommendTalents(Long): Result
        +saveSearchHistory(TalentSearchDTO): Result
    }

    class InterviewController {
        -interviewService: InterviewService
        +getInterviews(Integer, Integer): Result
        +getInterviewDetail(Long): Result
        +updateInterview(Long, InterviewDTO): Result
        +cancelInterview(Long, String): Result
        +getTodayInterviews(): Result
        +getInterviewStats(): Result
    }

    class ResumeManageController {
        -resumeManageService: ResumeManageService
        +getReceivedResumes(Long, Long, Integer, Integer): Result
        +reviewResume(Long, Integer, String): Result
        +batchReview(List, Integer, String): Result
        +addToFavorite(Long, Long): Result
        +exportResumes(List): Result
        +getResumeStats(): Result
    }

    class JobManageController {
        -jobManageService: JobManageService
        +publishPosition(PositionDTO): Result
        +editPosition(Long, PositionDTO): Result
        +refreshPosition(Long): Result
        +getMyPositions(Long, Integer, Integer): Result
        +getPositionStats(Long): Result
        +deletePosition(Long): Result
        +getPositionsList(Integer, Integer): Result
        +getPositionStatus(): Result
    }

    class CompanyController {
        -companyService: CompanyService
        +registerCompany(CompanyRegisterDTO): Result
        +submitAuth(CompanyAuthDTO): Result
        +getCompanyInfo(): Result
        +updateCompanyInfo(CompanyDTO): Result
        +getAuthStatus(): Result
        +disableCompany(Long): Result
        +enableCompany(Long): Result
        +getPendingAuth(): Result
        +auditCompany(Long, Integer, String): Result
    }

    %% 业务逻辑层 (Service)
    class TalentSearchService {
        +searchTalents(TalentSearchDTO): PageResult
        +viewPublicResume(Long, Long): ResumeDetailVO
        +inviteApply(Long, Long, String): void
        +getRecommendTalents(Long): List
        +saveSearchHistory(TalentSearchDTO): void
    }

    class InterviewService {
        +getInterviews(Long, Long, Integer, Integer): PageResult
        +getInterviewDetail(Long): InterviewDetailVO
        +updateInterview(Long, InterviewDTO): void
        +cancelInterview(Long, String): void
        +getTodayInterviews(Long): List
        +getInterviewStats(Long): InterviewStatsVO
    }

    class ResumeManageService {
        +getReceivedResumes(Long, Long, Integer, Integer): PageResult
        +reviewResume(Long, Integer, String): void
        +batchReview(List, Integer, String): void
        +addToFavorite(Long, Long): void
        +exportResumes(List): byte[]
        +getResumeStats(Long): ResumeStatsVO
    }

    class JobManageService {
        +createPosition(Long, PositionDTO): JobPosition
        +updatePosition(Long, PositionDTO): JobPosition
        +refreshPosition(Long): void
        +getMyPositions(Long, Integer, Integer): PageResult
        +getPositionStats(Long): PositionStatsVO
        +deletePosition(Long): void
        +getPositionsList(Long, Integer, Integer): PageResult
        +getPositionStatus(Long): PositionStatusVO
    }

    class CompanyService {
        +registerCompany(Long, CompanyRegisterDTO): CompanyInfo
        +submitAuth(Long, CompanyAuthDTO): void
        +getCompanyInfo(Long): CompanyInfo
        +updateCompanyInfo(Long, CompanyDTO): void
        +getAuthStatus(Long): AuthStatusVO
        +checkCompanyAuth(Long): Boolean
    }

    %% 实现类 (Impl)
    class TalentSearchServiceImpl {
        -talentDao: TalentSearchDao
        -seekerDao: SeekerDao
        -positionDao: PositionDao
        -messageService: MessageService
    }

    class InterviewServiceImpl {
        -interviewDao: InterviewDao
        -applicationDao: ApplicationDao
        -messageService: MessageService
    }

    class ResumeManageServiceImpl {
        -applicationDao: ApplicationDao
        -resumeDao: ResumeDao
        -favoriteDao: FavoriteDao
    }

    class JobManageServiceImpl {
        -companyDao: CompanyDao
        -positionDao: PositionDao
        -applicationDao: ApplicationDao
        -categoryDao: CategoryDao
    }

    class CompanyServiceImpl {
        -companyDao: CompanyDao
        -authDao: AuthDao
    }

    %% 数据服务层 (Dao)
    class CategoryDao {
        +selectById(Long): JobCategory
        +selectByParentId(Long): List
        +selectAll(): List
        +insertCategory(JobCategory): int
        +updateCategory(JobCategory): int
        +deleteCategory(Long): int
    }

    class PositionDao {
        +insertPosition(JobPosition): int
        +updatePosition(JobPosition): int
        +selectById(Long): JobPosition
        +selectByCompanyId(Long, Integer): List
        +updateRefreshTime(Long): int
        +selectByStatus(Long, Integer): List
        +countByCompanyAndStatus(Long, Integer): Long
    }

    class FavoriteDao {
        +insertFavorite(JobFavorite): int
        +deleteFavorite(Long, Long, Integer): int
        +selectByUserAndType(Long, Long, Integer): List
    }

    class CompanyDao {
        +insertCompany(CompanyInfo): int
        +updateCompany(CompanyInfo): int
        +selectById(Long): CompanyInfo
        +selectByUserId(Long): CompanyInfo
        +updateAuthStatus(Long, Integer): int
    }

    class TalentSearchDao {
        +searchTalents(TalentSearchDTO): List
        +viewPublicResume(Long): ResumeDetailVO
        +selectSkillsBySeekerId(Long): List
    }

    class SeekerDao {
        +selectById(Long): JobSeeker
        +selectExperiencesBySeekerId(Long): List
        +selectEducationBySeekerId(Long): List
    }

    class ResumeDao {
        +selectByUserId(Long): JobSeeker
        +selectPublicResumes(): List
    }

    class AuthDao {
        +selectByCompanyId(Long): CompanyAuth
        +updateAuditResult(Long, Integer, String, Long): int
    }

    class ApplicationDao {
        +selectByCompanyId(Long, Integer): List
        +selectByPositionId(Long, Integer): List
        +updateStatus(Long, Integer): int
        +countByCompanyAndStatus(Long, Integer): Long
    }

    class InterviewDao {
        +insertInterview(JobInterview): int
        +selectById(Long): JobInterview
        +selectByPositionId(Long, Integer): List
        +selectTodayInterviews(Long): List
        +updateStatus(Long, Integer): int
    }

    %% 实体层 (Entity)
    class JobCategory {
        -categoryId: Long
        -categoryName: String
        -categoryType: Integer
        -categoryLevel: Integer
        -status: Integer
    }

    class JobPosition {
        -positionId: Long
        -companyId: Long
        -positionName: String
        -categoryId: Long
        -positionType: Integer
        -salaryMin: BigDecimal
        -salaryMax: BigDecimal
        -city: String
        -district: String
        -experienceMin: Integer
        -education: Integer
        -workYears: BigDecimal
        -jobDesc: String
        -jobRequirement: String
        -viewCount: Integer
        -applyCount: Integer
        -isUrgent: Integer
        -publishTime: Date
        -refreshTime: Date
        -endTime: Date
    }

    class JobFavorite {
        -favoriteId: Long
        -userId: Long
        -targetId: Long
        -targetType: Integer
    }

    class CompanyInfo {
        -companyId: Long
        -userId: Long
        -companyName: String
        -shortName: String
        -companyLogo: String
        -companyScale: Integer
        -companyType: Integer
        -industry: String
        -address: String
        -district: String
        -contactName: String
        -contactPhone: String
        -website: String
        -status: Integer
        -positionCount: Integer
        -createTime: Date
    }

    class CompanyAuth {
        -authId: Long
        -companyId: Long
        -legalPerson: String
        -idCard: String
        -businessLicense: String
        -licenseImage: String
        -auditStatus: Integer
        -auditRemark: String
        -auditTime: Long
        -auditId: Long
        -auditTime: Date
    }

    class JobSeeker {
        -seekerId: Long
        -userId: Long
        -realName: String
        -gender: Integer
        -phone: String
        -email: String
        -selfIntro: String
        -expectedCity: String
        -expectedSalaryMin: BigDecimal
        -expectedSalaryMax: BigDecimal
        -isPublic: Integer
        -completeness: Integer
    }

    class JobApplication {
        -applicationId: Long
        -positionId: Long
        -companyId: Long
        -seekerId: Long
        -applyStatus: Integer
        -applyTime: Date
        -handleTime: Date
        -handleResult: String
    }

    class JobInterview {
        -interviewId: Long
        -applicationId: Long
        -positionId: Long
        -companyId: Long
        -seekerId: Long
        -interviewType: Integer
        -interviewDate: Date
        -interviewTime: Time
        -interviewAddress: String
        -contactName: String
        -contactPhone: String
        -status: Integer
        -replyMsg: String
        -replyTime: Date
    }

    %% 枚举
    class ApplyStatus {
        PENDING = 0
        ACCEPTED = 1
        REJECTED = 2
        CANCELLED = 3
    }

    class InterviewStatus {
        PENDING = 0
        ACCEPTED = 1
        REJECTED = 2
        CANCELLED = 3
        COMPLETED = 4
        NO_SHOW = 5
    }

    class InterviewType {
        ONLINE = 1
        VIDEO = 2
        PHONE = 3
    }

    class PositionStatus {
        DRAFT = 0
        PUBLISHED = 1
        CLOSED = 2
        EXPIRED = 3
        REJECTED = 4
    }

    class AuthStatus {
        PENDING = 0
        APPROVED = 1
        REJECTED = 2
    }

    %% 数据传输对象 (DTO/VO)
    class TalentDTO {
        -seekerId: Long
        -realName: String
        -education: String
        -major: String
        -workExperience: Integer
        -expectedCity: String
        -skills: List
    }

    class ResumeDetailVO {
        -seekerId: Long
        -realName: String
        -phone: String
        -email: String
        -gender: Integer
        -selfIntro: String
        -educations: List
        -experiences: List
        -skills: List
    }

    class InterviewDTO {
        -interviewDate: Date
        -interviewTime: Time
        -interviewAddress: String
        -contactName: String
        -contactPhone: String
        -remark: String
    }

    class InterviewDetailVO {
        -interviewId: Long
        -positionName: String
        -companyName: String
        -seekerName: String
        -seekerPhone: String
        -interviewDate: Date
        -interviewTime: Time
        -interviewAddress: String
        -status: Integer
        -replyMsg: String
    }

    class InterviewStatsVO {
        -total: Integer
        -today: Integer
        -pending: Integer
        -completed: Integer
    }

    class PositionDTO {
        -positionName: String
        -categoryId: Long
        -positionType: Integer
        -salaryMin: BigDecimal
        -salaryMax: BigDecimal
        -city: String
        -district: String
        -experienceMin: Integer
        -education: Integer
        -jobDesc: String
        -jobRequirement: String
        -isUrgent: Integer
    }

    class CompanyRegisterDTO {
        -companyName: String
        -shortName: String
        -companyScale: Integer
        -companyType: Integer
        -industry: String
        -contactName: String
        -contactPhone: String
    }

    class CompanyAuthDTO {
        -legalPerson: String
        -idCard: String
        -businessLicense: String
        -licenseImage: String
    }

    %% 关系
    TalentSearchController ..> TalentSearchService
    InterviewController ..> InterviewService
    ResumeManageController ..> ResumeManageService
    JobManageController ..> JobManageService
    CompanyController ..> CompanyService

    TalentSearchService <|-- TalentSearchServiceImpl
    InterviewService <|-- InterviewServiceImpl
    ResumeManageService <|-- ResumeManageServiceImpl
    JobManageService <|-- JobManageServiceImpl
    CompanyService <|-- CompanyServiceImpl

    TalentSearchServiceImpl ..> TalentSearchDao
    TalentSearchServiceImpl ..> SeekerDao
    TalentSearchServiceImpl ..> PositionDao

    InterviewServiceImpl ..> InterviewDao
    InterviewServiceImpl ..> ApplicationDao

    ResumeManageServiceImpl ..> ApplicationDao
    ResumeManageServiceImpl ..> ResumeDao
    ResumeManageServiceImpl ..> FavoriteDao

    JobManageServiceImpl ..> CompanyDao
    JobManageServiceImpl ..> PositionDao
    JobManageServiceImpl ..> ApplicationDao
    JobManageServiceImpl ..> CategoryDao

    CompanyServiceImpl ..> CompanyDao
    CompanyServiceImpl ..> AuthDao