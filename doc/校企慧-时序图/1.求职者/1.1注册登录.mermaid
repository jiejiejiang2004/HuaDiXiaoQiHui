sequenceDiagram
    participant User as 求职者
    participant Controller as LoginController
    participant Service as LoginService
    participant Dao as LoginDao
    participant UCenter as 统一用户接口
    participant SMS as 短信接口

    %% ==========================================
    %% 1. 手机号注册
    %% ==========================================
    Note over User, SMS: 手机号注册
    User->>Controller: 输入手机号、验证码、密码
    activate Controller
    Controller->>Service: 注册(手机号, 验证码, 密码)
    activate Service

    Service->>SMS: 校验验证码
    activate SMS
    SMS-->>Service: 验证码正确
    deactivate SMS

    Service->>Dao: 检查手机号是否已注册
    activate Dao
    Dao-->>Service: 未注册
    deactivate Dao

    Service->>Service: 保存用户信息<br/>(密码BCrypt加密)
    Service-->>Service: 返回用户ID

    Service->>UCenter: 同步账号至统一平台
    activate UCenter
    UCenter-->>Service: 同步成功
    deactivate UCenter

    Service-->>Controller: 注册成功
    deactivate Service
    Controller-->>User: 跳转至登录页
    deactivate Controller

    %% ==========================================
    %% 2. 密码登录
    %% ==========================================
    Note over User, SMS: 密码登录
    User->>Controller: 输入账号/手机号、密码
    activate Controller
    Controller->>Service: 登录(账号/手机号, 密码)
    activate Service

    Service->>Dao: 根据账号查询用户信息
    activate Dao
    Dao-->>Service: 返回用户信息<br/>(含加密密码)
    deactivate Dao

    Service->>Service: BCrypt校验密码

    alt 密码正确
        Service->>Service: 生成JWT Token
        Service->>Dao: 更新最后登录时间
        activate Dao
        deactivate Dao

        Service-->>Controller: 返回Token及用户信息
        Controller-->>User: 登录成功, 进入首页
    else 密码错误
        Service-->>Controller: 密码错误
        Controller-->>User: 提示密码错误
    end

    deactivate Service
    deactivate Controller

    %% ==========================================
    %% 3. 短信验证码登录
    %% ==========================================
    Note over User, SMS: 短信验证码登录
    User->>Controller: 输入手机号、短信验证码
    activate Controller
    Controller->>Service: smsLogin(手机号, 短信验证码)
    activate Service

    Service->>SMS: 校验验证码
    activate SMS
    SMS-->>Service: 验证码正确
    deactivate SMS

    Service->>Dao: 根据手机号查询用户
    activate Dao
    Dao-->>Service: 返回用户信息
    deactivate Dao

    Service->>Service: 生成JWT Token

    Service-->>Controller: 返回Token及用户信息
    Controller-->>User: 登录成功
    deactivate Service
    deactivate Controller

    %% ==========================================
    %% 4. 忘记密码/重置密码
    %% ==========================================
    Note over User, SMS: 忘记密码/重置密码
    User->>Controller: 输入手机号、新密码、验证码
    activate Controller
    Controller->>Service: 重置密码(手机号, 新密码, 验证码)
    activate Service

    Service->>SMS: 校验验证码
    activate SMS
    SMS-->>Service: 验证码正确
    deactivate SMS

    Service->>Dao: 更新密码(BCrypt加密)
    activate Dao
    Dao-->>Service: 更新成功
    deactivate Dao

    Service-->>Controller: 重置成功
    Controller-->>User: 返回登录页
    deactivate Service
    deactivate Controller