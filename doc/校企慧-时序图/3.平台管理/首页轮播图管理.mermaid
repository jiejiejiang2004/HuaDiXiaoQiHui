sequenceDiagram
    participant Admin as 平台管理员
    participant Controller as SystemController
    participant Service as SystemService
    participant Dao as SystemDao

    %% 首页轮播图管理
    Note over Admin, Dao: 首页轮播图管理
    Admin->>Controller: 进入"轮播图管理"页面
    activate Controller
    Controller->>Service: getBannerList()
    activate Service
    Service->>Dao: 查询所有轮播图(按排序顺序)
    activate Dao
    Dao-->>Service: 返回轮播图列表
    deactivate Dao
    Service-->>Controller: 返回轮播图列表
    deactivate Service
    Controller-->>Admin: 展示轮播图列表(图片预览/排序/状态)
    deactivate Controller

    %% 添加/编辑轮播图
    Note over Admin, Dao: 添加/编辑轮播图
    Admin->>Controller: 添加/编辑轮播图
    activate Controller
    alt 添加轮播图
        Admin->>Controller: 上传图片，填写链接
        Controller->>Service: addBanner(bannerDTO)
        activate Service
        Service->>Service: 上传图片至文件服务器
        Service->>Dao: 插入轮播图记录
        activate Dao
        Dao-->>Service: 插入成功
        deactivate Dao
        Service-->>Controller: 添加成功
        deactivate Service
    else 编辑轮播图
        Admin->>Controller: 修改图片/链接/排序
        Controller->>Service: updateBanner(bannerId, bannerDTO)
        activate Service
        Service->>Dao: 更新轮播图信息
        activate Dao
        Dao-->>Service: 更新成功
        deactivate Dao
        Service-->>Controller: 更新成功
        deactivate Service
    end
    Controller-->>Admin: 提示操作成功
    deactivate Controller

    %% 下架轮播图
    Note over Admin, Dao: 下架轮播图
    Admin->>Controller: 点击"下架"轮播图
    activate Controller
    Controller->>Service: disableBanner(bannerId)
    activate Service
    Service->>Dao: 更新status='DISABLED'
    activate