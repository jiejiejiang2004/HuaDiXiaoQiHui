sequenceDiagram
    participant HR as 企业HR
    participant Controller as JobManageController
    participant Service as JobManageService
    participant Dao as JobManageDao
    participant MsgService as MessageService
    participant Admin as 平台管理员

    %% ==========================================
    %% 1. 填写职位信息并提交
    %% ==========================================
    Note over HR, Admin: 填写职位信息并提交
    HR->>Controller: 进入职位发布页面
    activate Controller
    Controller->>Service: 获取职位分类()
    activate Service
    Service->>Dao: 查询行业/职位分类树
    activate Dao
    Dao-->>Service: 返回分类列表
    deactivate Dao
    Service-->>Controller: 返回分类数据
    deactivate Service
    Controller-->>HR: 展示职位发布表单<br/>(分类/名称/职责/要求/薪资/地点/人数/学历)

    HR->>Controller: 填写职位信息并提交
    activate Controller
    Controller->>Service: 发布职位(企业Id, 职位DTO)
    activate Service
    Service->>Service: 数据校验<br/>(必填项/薪资范围/学历枚举等)
    Service->>Dao: 插入职位记录<br/>(状态:待审核)
    activate Dao
    Note right of Dao: 职位状态:<br/>- PENDING: 待审核<br/>- ACTIVE: 招聘中<br/>- CLOSED: 已结束<br/>- REJECTED: 已驳回
    Dao-->>Service: 返回职位ID
    deactivate Dao

    Service->>MsgService: 异步通知管理员<br/>有新的职位待审核
    activate MsgService
    MsgService-->>Service: 通知已发送
    deactivate MsgService

    Service-->>Controller: 发布成功, 返回职位ID
    deactivate Service
    Controller-->>HR: 提示"职位已提交，审核通过后将自动上线"
    deactivate Controller

    %% ==========================================
    %% 2. 平台审核职位（管理员视角）
    %% ==========================================
    Note over HR, Admin: 平台审核职位（管理员视角）
    Admin->>Controller: 查看待审核职位列表
    activate Controller
    Controller->>Service: 获取待审核职位
    activate Service
    Service->>Dao: 查询status='PENDING'的职位
    activate Dao
    Dao-->>Service: 返回职位列表
    deactivate Dao

    Service->>Dao: 关联查询企业信息
    activate Dao
    Dao-->>Service: 补充企业名称/Logo
    deactivate Dao

    Service-->>Controller: 返回待审核职位
    deactivate Service
    Controller-->>Admin: 展示职位审核列表
    deactivate Controller

    alt 审核通过
        Admin->>Controller: 点击"通过审核"
        activate Controller
        Controller->>Service: 同意职位审核
        activate Service
        Service->>Dao: 更新status='ACTIVE'<br/>设置上线时间
        activate Dao
        Dao-->>Service: 更新成功
        deactivate Dao
        Service->>MsgService: 通知企业HR<br/>职位已审核通过
        activate MsgService
        MsgService-->>Service: 通知已发送
        deactivate MsgService
        Service-->>Controller: 审核通过
        deactivate Service
        Controller-->>Admin: 确认通过
        deactivate Controller
    else 审核驳回
        Admin->>Controller: 填写驳回原因并点击"驳回"
        activate Controller
        Controller->>Service: 驳回
        activate Service
        Service->>Dao: 更新status='REJECTED'<br/>保存驳回原因和审核备注
        activate Dao
        Dao-->>Service: 更新成功
        deactivate Dao
        Service->>MsgService: 通知企业HR驳回原因
        activate MsgService
        MsgService-->>Service: 通知已发送
        deactivate MsgService
        Service-->>Controller: 驳回成功
        deactivate Service
        Controller-->>Admin: 确认驳回
        deactivate Controller
    end

    %% ==========================================
    %% 3. 查看职位列表 (HR视角)
    %% ==========================================
    Note over HR, Admin: 查看职位列表
    HR->>Controller: 进入"我的职位"页面
    activate Controller
    Controller->>Service: 获取职位列表
    activate Service
    Service->>Dao: 分页查询职位<br/>(支持按状态筛选)
    activate Dao
    Note right of Dao: 状态筛选:<br/>- ACTIVE: 招聘中<br/>- CLOSED: 已结束<br/>- PENDING: 待审核<br/>- REJECTED: 已驳回
    Dao-->>Service: 返回职位列表及总数
    deactivate Dao

    Service->>Service: 补充统计数据<br/>(每个职位的浏览量/投递量)
    Service-->>Controller: 返回职位列表
    deactivate Service
    Controller-->>HR: 展示职位管理表格
    deactivate Controller

    %% ==========================================
    %% 4. 编辑职位
    %% ==========================================
    Note over HR, Admin: 编辑职位
    HR->>Controller: 点击"编辑"职位
    activate Controller
    Controller->>Service: 获取职位信息详细
    activate Service
    Service->>Dao: 校验职位归属企业
    activate Dao
    Dao-->>Service: 验证通过
    deactivate Dao
    Service->>Dao: 查询职位详情
    activate Dao
    Dao-->>Service: 返回职位信息
    deactivate Dao
    Service-->>Controller: 返回职位详情
    deactivate Service
    Controller-->>HR: 展示编辑表单(预填现有数据)

    HR->>Controller: 修改职位信息并提交
    activate Controller
    Controller->>Service: 修改职位
    activate Service
    Service->>Dao: 校验职位归属
    activate Dao
    Dao-->>Service: 验证通过
    deactivate Dao

    alt 职位状态为'ACTIVE'或'REJECTED'
        Service->>Dao: 更新职位信息<br/>(状态重置为'PENDING'需重新审核)
        activate Dao
        Note right of Dao: 编辑后需重新审核
        Dao-->>Service: 更新成功
        deactivate Dao
    else 职位状态为'CLOSED'
        Service-->>Controller: 提示"已结束的职位不可编辑"
    end

    Service-->>Controller: 更新成功
    deactivate Service
    Controller-->>HR: 提示"职位已更新，待审核"
    deactivate Controller

    %% ==========================================
    %% 5. 下架职位
    %% ==========================================
    Note over HR, Admin: 下架职位
    HR->>Controller: 点击"下架"职位
    activate Controller
    Controller->>Service: 下架职位
    activate Service
    Service->>Dao: 校验职位归属及当前状态
    activate Dao
    Dao-->>Service: 验证通过(状态为ACTIVE)
    deactivate Dao
    Service->>Dao: 更新status='CLOSED'
    activate Dao
    Dao-->>Service: 更新成功
    deactivate Dao
    Service-->>Controller: 下架成功
    deactivate Service
    Controller-->>HR: 提示"职位已下架"<br/>职位状态变为"已结束"
    deactivate Controller

    %% ==========================================
    %% 6. 刷新职位
    %% ==========================================
    Note over HR, Admin: 刷新职位
    HR->>Controller: 点击"刷新"职位
    activate Controller
    Controller->>Service: 刷新职位
    activate Service
    Service->>Dao: 校验职位归属及状态<br/>(必须是ACTIVE状态)
    activate Dao
    Dao-->>Service: 验证通过
    deactivate Dao
    Service->>Dao: 更新refresh_time=now()<br/>职位列表按刷新时间排序
    activate Dao
    Dao-->>Service: 更新成功
    deactivate Dao
    Service-->>Controller: 刷新成功
    deactivate Service
    Controller-->>HR: 提示"职位已刷新，将排在更前面"
    deactivate Controller

    %% ==========================================
    %% 7. 删除职位
    %% ==========================================
    Note over HR, Admin: 删除职位
    HR->>Controller: 点击"删除"职位
    activate Controller
    Controller->>Service: 删除职位
    activate Service
    Service->>Dao: 校验职位归属
    activate Dao
    Dao-->>Service: 验证通过
    deactivate Dao
    Service->>Dao: 检查是否有未处理的投递记录
    activate Dao
    Dao-->>Service: 存在投递记录(提醒)
    deactivate Dao

    alt 确认删除
        Service->>Dao: 逻辑删除职位<br/>(设置is_deleted=1)
        activate Dao
        Dao-->>Service: 删除成功
        deactivate Dao
        Service-->>Controller: 删除成功
        Controller-->>HR: 提示"职位已删除"
    else 取消删除
        Controller-->>HR: 取消操作
    end
    deactivate Service
    deactivate Controller

    %% ==========================================
    %% 8. 职位预览与分享
    %% ==========================================
    Note over HR, Admin: 职位预览与分享
    HR->>Controller: 点击"预览"职位
    activate Controller
    Controller->>Service: 预览职位
    activate Service
    Service->>Dao: 查询职位完整信息
    activate Dao
    Dao-->>Service: 返回职位数据
    deactivate Dao
    Service->>Dao: 查询企业信息
    activate Dao
    Dao-->>Service: 返回企业信息
    deactivate Dao
    Service-->>Controller: 返回预览数据
    deactivate Service
    Controller-->>HR: 弹窗/新页面展示职位预览
    deactivate Controller

    HR->>Controller: 点击"分享"职位
    activate Controller
    Controller->>Service: 生成分享链接
    activate Service
    Service->>Service: 生成分享Token<br/>(带时效性)
    Service-->>Controller: 返回分享链接
    deactivate Service
    Controller-->>HR: 显示二维码/复制链接
    deactivate Controller